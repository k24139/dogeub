# Set the port on which Doge V5 will run on.
# PORT=2345

# Choose whether or not to use the Bare Server.
# Set to false to disable the Bare endpoint.
# BARE="false"

# Choose whether or not you want to enable MASQR.
# Separate licensing server required for this to work.
# https://github.com/titaniumnetwork-dev/MasqrProject
# MASQR="false"
# When MASQR is enabled, set a long random cookie signing secret.
# MASQR_COOKIE_SECRET="replace-with-a-long-random-secret"
# MASQR_LICENSE_SERVER_URL="http://localhost:8004/validate"
